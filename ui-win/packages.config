<?xml version="1.0" encoding="utf-8"?>
<!-- Windows App SDK components the UI needs, listed one by one: packages.config does not resolve
     transitive dependencies, and the Microsoft.WindowsAppSDK metapackage would also pull in AI, ML,
     Search and Widgets. -->
<packages>
  <package id="Microsoft.Web.WebView2" version="1.0.3719.77" targetFramework="native" />
  <package id="Microsoft.Windows.CppWinRT" version="2.0.250303.1" targetFramework="native" />
  <package id="Microsoft.Windows.ImplementationLibrary" version="1.0.260126.7" targetFramework="native" />
  <package id="Microsoft.Windows.SDK.BuildTools" version="10.0.26100.4654" targetFramework="native" />
  <package id="Microsoft.Windows.SDK.BuildTools.MSIX" version="1.7.251221100" targetFramework="native" />
  <package id="Microsoft.WindowsAppSDK.Base" version="2.0.4" targetFramework="native" />
  <package id="Microsoft.WindowsAppSDK.Foundation" version="2.3.12" targetFramework="native" />
  <package id="Microsoft.WindowsAppSDK.InteractiveExperiences" version="2.1.9" targetFramework="native" />
  <package id="Microsoft.WindowsAppSDK.WinUI" version="2.3.9" targetFramework="native" />
</packages>
