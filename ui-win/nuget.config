<?xml version="1.0" encoding="utf-8"?>
<configuration>
  <config>
    <!-- packages.config restores next to the project, where Cardinal.vcxproj imports them from. -->
    <add key="repositoryPath" value="packages" />
  </config>
  <packageSources>
    <clear />
    <add key="nuget.org" value="https://api.nuget.org/v3/index.json" />
  </packageSources>
</configuration>
